    "import ray\n",
    "import os\n",
    "\n",
    "# Suppress the Ray warning\n",
    "os.environ[\"RAY_ACCEL_ENV_VAR_OVERRIDE_ON_ZERO\"] = \"0\"\n",
    "\n",
    "ray.shutdown()\n",
    "ray.init(address='auto')\n",
    "\n",
    "print(\"Cluster Resources:\", ray.cluster_resources())\n",
    "print(\"Nodes in cluster:\", len(ray.nodes()))\n",
    "\n",
    "ray.shutdown()"
